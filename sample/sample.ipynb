      "source": [
        "#上辺：10cm\n",
        "#下辺：20cm\n",
        "#高さ：5cm\n",
        "\n",
        "#公式：台形の面積 =（上辺＋下辺）× 高さ ÷ 2\n",
        "upper = 10\n",
        "lower = 20\n",
        "height = 5\n",
        "\n",
        "area = (upper + lower) * height /2\n",
        "\n",
        "print(str(area) + \"cm²\")"
      ]
    }
